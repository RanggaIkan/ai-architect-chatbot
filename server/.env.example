# Google AI Studio API Key (Server-Side Only — NEVER expose to the browser)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional: Override default Gemini Free-Tier model chain
GEMINI_PRIMARY_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Local Express Server Config
PORT=5000
CLIENT_URL=http://localhost:3000
